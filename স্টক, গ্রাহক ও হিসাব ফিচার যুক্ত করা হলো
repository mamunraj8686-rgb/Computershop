<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#0F4C81">
    <title>কম্পিউটার ও মেরামত ব্যবস্থাপনা সিস্টেম</title>
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Roboto, 'Noto Sans Bengali', sans-serif; }
        :root {
            --primary: #0F4C81; --primary-light: #1A73E8; --primary-dark: #0A3366;
            --success: #22C55E; --warning: #F59E0B; --danger: #EF4444; --info: #3B82F6;
            --light: #F8FAFC; --dark: #1E293B; --gray: #94A3B8; --border: #E2E8F0;
            --shadow: 0 4px 20px rgba(0,0,0,0.08); --radius: 10px; --header-h: 60px; --sidebar-w: 270px;
        }
        body { background: #F1F5F9; color: var(--dark); padding-top: var(--header-h); transition: padding-left 0.3s; }

        /* টপ হেডার */
        .top-header {
            position: fixed; top: 0; left: 0; right: 0; height: var(--header-h);
            background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: white;
            display: flex; align-items: center; justify-content: space-between; padding: 0 16px; z-index: 999;
        }
        .menu-btn { background: rgba(255,255,255,0.2); border: none; color: white; width: 38px; height: 38px; border-radius: 8px; font-size: 18px; cursor: pointer; }
        .online-indicator { display: flex; align-items: center; gap: 6px; font-size: 13px; }
        .status-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--success); animation: pulse 2s infinite; }
        .status-dot.offline { background: var(--danger); }
        @keyframes pulse { 0%,100% { opacity:1; } 50% { opacity:0.4; } }
        .global-search { flex: 1; max-width: 350px; padding: 8px 12px; border-radius: 20px; border: none; font-size: 14px; }
        .icon-btn { background: rgba(255,255,255,0.2); border: none; color: white; width: 38px; height: 38px; border-radius: 8px; font-size: 16px; cursor: pointer; position: relative; }
        .badge { position: absolute; top: -2px; right: -2px; background: var(--danger); color: white; font-size: 10px; padding: 1px 5px; border-radius: 10px; }

        /* সাইডবার */
        .sidebar-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 998; display: none; }
        .sidebar-overlay.show { display: block; }
        .sidebar {
            position: fixed; top: var(--header-h); left: 0; bottom: 0; width: var(--sidebar-w); background: white;
            box-shadow: 2px 0 15px rgba(0,0,0,0.1); z-index: 999; transform: translateX(-100%); transition: transform 0.3s; overflow-y: auto;
        }
        .sidebar.show { transform: translateX(0); }
        .sidebar-link { display: flex; align-items: center; gap: 10px; padding: 10px 14px; margin: 4px 12px; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 500; transition: 0.2s; }
        .sidebar-link.active, .sidebar-link:hover { background: rgba(15,76,129,0.1); color: var(--primary); }

        /* মূল কন্টেন্ট */
        .main-content { padding: 16px; max-width: 1200px; margin: 0 auto; }
        .page { display: none; animation: fadeIn 0.3s; }
        .page.active { display: block; }
        @keyframes fadeIn { from { opacity:0; transform: translateY(8px); } to { opacity:1; transform: translateY(0); } }
        .page-title { font-size: 20px; font-weight: 700; color: var(--primary); margin-bottom: 16px; padding-bottom: 8px; border-bottom: 2px solid var(--border); }
        .card { background: white; border-radius: var(--radius); box-shadow: var(--shadow); padding: 18px; margin-bottom: 16px; }
        .btn { padding: 10px 16px; border: none; border-radius: 8px; font-size: 14px; font-weight: 500; cursor: pointer; transition: 0.2s; display: inline-flex; align-items: center; gap: 6px; }
        .btn-primary { background: var(--primary); color: white; }
        .btn-success { background: var(--success); color: white; }
        .btn-warning { background: var(--warning); color: white; }
        .btn-danger { background: var(--danger); color: white; }
        .btn-outline { background: white; border: 1px solid var(--border); color: var(--dark); }
        .btn-sm { padding: 6px 12px; font-size: 13px; }
        .form-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; margin-bottom: 14px; }
        .form-group { display: flex; flex-direction: column; gap: 6px; }
        label { font-size: 13px; font-weight: 600; color: #475569; }
        input, select, textarea { padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; font-size: 14px; background: white; }
        .filter-group { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
        .filter-btn { padding: 6px 12px; border-radius: 20px; border: none; font-size: 13px; cursor: pointer; }
        .status-received { background: #FEF3C7; color: #92400E; }
        .status-diagnosing { background: #DBEAFE; color: #1E40AF; }
        .status-waiting { background: #FED7AA; color: #C2410C; }
        .status-ready { background: #D1FAE5; color: #065F46; }
        .status-delivered { background: #E0E7FF; color: #3730A3; }
        .status-cancel { background: #FEE2E2; color: #B91C1C; }
        .ticket-card, .cust-card, .stock-card { border-left: 4px solid var(--primary); margin-bottom: 12px; padding: 14px; background: white; border-radius: var(--radius); }
        .ticket-actions, .cust-actions, .stock-actions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
        .check-group { display: flex; flex-direction: column; gap: 8px; margin: 10px 0; }
        .scan-field { display: flex; gap: 8px; align-items: flex-end; }
        .scan-field input { flex: 1; }
        .grid-lock { display: grid; grid-template-columns: repeat(3,1fr); gap:10px; max-width:220px; margin:10px 0; }
        .grid-dot { width:60px; height:60px; border-radius:50%; border:2px solid var(--border); background:white; cursor:pointer; }
        .grid-dot.active { background:var(--primary); border-color:var(--primary); }
        .summary-box { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px,1fr)); gap:12px; text-align:center; }
        .summary-item h3 { font-size:24px; margin-bottom:4px; }
        .modal { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.8); z-index:9999; padding:20px; overflow-y:auto; }
        .modal.active { display:flex; align-items:center; justify-content:center; }
        .modal-content { background:white; border-radius:var(--radius); width:100%; max-width:480px; padding:20px; position:relative; }
        .modal-close { position:absolute; top:12px; right:12px; background:var(--danger); color:white; border:none; width:32px; height:32px; border-radius:50%; font-size:16px; cursor:pointer; }
        #reader { width:100%; border-radius:var(--radius); overflow:hidden; margin:12px 0; }
        .receipt-preview { max-width:320px; margin:0 auto; padding:20px; background:white; border:1px dashed #333; }
        .receipt-preview h3 { text-align:center; margin-bottom:12px; border-bottom:1px dashed #333; padding-bottom:8px; }
        .receipt-preview p { font-size:13px; margin:4px 0; }
        @media (min-width:992px) {
            body { padding-left:var(--sidebar-w); }
            .sidebar { transform:translateX(0); }
            .menu-btn { display:none; }
            .sidebar-overlay { display:none !important; }
        }
        @media print {
            body * { visibility:hidden; }
            .receipt-preview, .receipt-preview * { visibility:visible; position:static; }
            .receipt-preview { width:80mm; margin:0 auto; }
        }
    </style>
</head>
<body>

<header class="top-header">
    <div style="display:flex; align-items:center; gap:12px;">
        <button class="menu-btn" onclick="toggleSidebar()">☰</button>
        <div class="online-indicator">
            <span class="status-dot" id="netDot"></span>
            <span id="netText">অনলাইন</span>
        </div>
    </div>
    <input type="text" class="global-search" placeholder="টিকিট/ফোন/পণ্য খুঁজুন..." id="globalSearch">
    <div style="display:flex; gap:8px;">
        <button class="icon-btn" onclick="syncData()">🔄</button>
        <button class="icon-btn">🔔<span class="badge" id="notifBadge">0</span></button>
        <button class="icon-btn">👤</button>
    </div>
</header>

<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>
<aside class="sidebar" id="sidebar">
    <div class="sidebar-link active" data-page="dashboard" onclick="showPage('dashboard')">📊 ড্যাশবোর্ড</div>
    <div class="sidebar-link" data-page="tickets" onclick="showPage('tickets')">🎟️ মেরামত টিকিট</div>
    <div class="sidebar-link" data-page="diagnosis" onclick="showPage('diagnosis')">🧠 স্মার্ট ডায়াগনস্টিক</div>
    <div class="sidebar-link" data-page="inventory" onclick="showPage('inventory')">📦 স্টক ও পার্টস</div>
    <div class="sidebar-link" data-page="customers" onclick="showPage('customers')">👥 গ্রাহক তালিকা</div>
    <div class="sidebar-link" data-page="accounts" onclick="showPage('accounts')">💳 হিসাব-নিকাশ</div>
    <div class="sidebar-link" data-page="settings" onclick="showPage('settings')">⚙️ সেটিংস ও ব্যাকআপ</div>
</aside>

<main class="main-content">
    <!-- ড্যাশবোর্ড -->
    <section class="page active" id="dashboard">
        <h2 class="page-title">ড্যাশবোর্ড সারসংক্ষেপ</h2>
        <div class="summary-box">
            <div class="card"><h3 id="dTotal">0</h3><p>মোট টিকিট</p></div>
            <div class="card"><h3 id="dRunning">0</h3><p>চলমান কাজ</p></div>
            <div class="card"><h3 id="dReady">0</h3><p>প্রস্তুত</p></div>
            <div class="card"><h3 id="dDelivered">0</h3><p>ডেলিভারি</p></div>
            <div class="card"><h3 id="dCust">0</h3><p>গ্রাহক</p></div>
            <div class="card"><h3 id="dStock">0</h3><p>স্টক আইটেম</p></div>
            <div class="card"><h3 style="color:var(--success)" id="dIncome">০</h3><p>মোট আয়</p></div>
            <div class="card"><h3 style="color:var(--warning)" id="dDue">০</h3><p>বাকি টাকা</p></div>
        </div>
        <div class="card">
            <h3 style="margin-bottom:12px;">দ্রুত কাজ</h3>
            <div style="display:flex; flex-wrap:wrap; gap:10px;">
                <button class="btn btn-primary" onclick="showPage('newTicket')">➕ নতুন টিকিট</button>
                <button class="btn btn-success" onclick="openScanner()">📲 কোড স্ক্যান</button>
                <button class="btn btn-outline" onclick="showPage('inventory')">📦 স্টক যুক্ত</button>
            </div>
        </div>
    </section>

    <!-- টিকিট পৃষ্ঠা -->
    <section class="page" id="tickets">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
            <h2 class="page-title" style="border:none; margin:0;">মেরামত টিকিট ব্যবস্থাপনা</h2>
            <button class="btn btn-primary" onclick="showPage('newTicket')">➕ নতুন টিকিট</button>
        </div>
        <div class="filter-group">
            <button class="filter-btn status-received active" data-filter="all" onclick="filterTickets('all')">সব</button>
            <button class="filter-btn status-received" data-filter="জমা নেওয়া হয়েছে" onclick="filterTickets('জমা নেওয়া হয়েছে')">জমা নেওয়া</button>
            <button class="filter-btn status-diagnosing" data-filter="পরীক্ষা করা হচ্ছে" onclick="filterTickets('পরীক্ষা করা হচ্ছে')">পরীক্ষা চলছে</button>
            <button class="filter-btn status-waiting" data-filter="পার্টসের অপেক্ষায়" onclick="filterTickets('পার্টসের অপেক্ষায়')">পার্টস অপেক্ষা</button>
            <button class="filter-btn status-ready" data-filter="ডেলিভারির জন্য প্রস্তুত" onclick="filterTickets('ডেলিভারির জন্য প্রস্তুত')">প্রস্তুত</button>
            <button class="filter-btn status-delivered" data-filter="ডেলিভারি দেওয়া হয়েছে" onclick="filterTickets('ডেলিভারি দেওয়া হয়েছে')">ডেলিভারি</button>
            <button class="filter-btn status-cancel" data-filter="বাতিল/মেরামত নয়" onclick="filterTickets('বাতিল/মেরামত নয়')">বাতিল</button>
        </div>
        <div id="ticketList"></div>
    </section>

    <!-- নতুন টিকিট -->
    <section class="page" id="newTicket">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
            <h2 class="page-title" style="border:none; margin:0;">নতুন টিকিট তৈরি</h2>
            <button class="btn btn-outline" onclick="showPage('tickets')">← ফিরে যান</button>
        </div>
        <form id="ticketFormMain" class="card">
            <h3 style="margin-bottom:12px;">গ্রাহকের তথ্য</h3>
            <div class="form-row">
                <div class="form-group"><label>নাম *</label><input type="text" id="custName" required></div>
                <div class="form-group"><label>মোবাইল *</label><input type="tel" id="custMobile" required placeholder="01XXXXXXXXX"></div>
            </div>
            <div class="form-group"><label>ঠিকানা</label><textarea id="custAddr" rows="2"></textarea></div>
            <h3 style="margin:18px 0 12px;">ডিভাইসের তথ্য</h3>
            <div class="form-group">
                <label>সিরিয়াল/কোড</label>
                <div class="scan-field">
                    <input type="text" id="devCode" placeholder="স্ক্যান বা লিখুন">
                    <button type="button" class="btn btn-success" onclick="openScanner()">📲 স্ক্যান</button>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>ডিভাইসের ধরন *</label>
                    <select id="devCat" required>
                        <option value="">নির্বাচন</option>
                        <option>মোবাইল ফোন</option><option>ল্যাপটপ</option><option>ডেস্কটপ</option>
                        <option>প্রিন্টার</option><option>মনিটর</option><option>টেলিভিশন</option><option>অন্যান্য</option>
                    </select>
                </div>
                <div class="form-group"><label>ব্র্যান্ড ও মডেল</label><input type="text" id="devModel"></div>
            </div>
            <div class="form-group"><label>লক প্যাটার্ন</label><div class="grid-lock" id="lockGrid"></div><input type="hidden" id="lockPattern"></div>
            <div class="form-group">
                <label>সাথে পাওয়া গেছে</label>
                <div class="check-group">
                    <label class="check-item"><input type="checkbox" id="accCharger"> চার্জার</label>
                    <label class="check-item"><input type="checkbox" id="accMem"> মেমরি কার্ড</label>
                    <label class="check-item"><input type="checkbox" id="accSim"> সিম কার্ড</label>
                    <label class="check-item"><input type="checkbox" id="accBox"> বক্স</label>
                </div>
            </div>
            <div class="form-group"><label>সমস্যা</label><textarea id="devProblem" rows="3"></textarea></div>
            <div class="form-row">
                <div class="form-group"><label>অগ্রিম টাকা (টাকা)</label><input type="number" id="advPay" min="0" value="0"></div>
                <div class="form-group"><label>মোট অনুমানিত খরচ (টাকা)</label><input type="number" id="totalCost" min="0" value="0"></div>
            </div>
            <div style="display:flex; gap:10px; margin-top:18px;">
                <button type="submit" class="btn btn-primary">💾 সংরক্ষণ</button>
                <button type="reset" class="btn btn-outline">রিসেট</button>
            </div>
        </form>
    </section>

    <!-- ডায়াগনস্টিক -->
    <section class="page" id="diagnosis">
        <h2 class="page-title">স্মার্ট ডায়াগনস্টিক ও সমাধান</h2>
        <div class="card">
            <div class="form-group">
                <label>ডিভাইস কোড</label>
                <div class="scan-field">
                    <input type="text" id="diagCode">
                    <button class="btn btn-sm btn-success" onclick="openScanner()">📷 স্ক্যান</button>
                </div>
            </div>
            <h3 style="margin:16px 0 10px;">সমস্যা নির্বাচন</h3>
            <div class="check-group">
                <label class="check-item"><input type="checkbox" class="symptom"> পাওয়ার নেই/মৃত</label>
                <label class="check-item"><input type="checkbox" class="symptom"> চার্জ হচ্ছে না</label>
                <label class="check-item"><input type="checkbox" class="symptom"> ডিসপ্লে ভাঙা/ঝাপসা</label>
                <label class="check-item"><input type="checkbox" class="symptom"> গরম হয়/ব্যাটারি দ্রুত শেষ</label>
                <label class="check-item"><input type="checkbox" class="symptom"> অন্য সমস্যা</label>
            </div>
            <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:16px;">
                <button class="btn btn-primary" onclick="showSolution()">💡 সমাধান দেখুন</button>
                <button class="btn btn-outline" onclick="alert('ডায়াগ্রাম খোঁজা হচ্ছে...')">🔍 সার্কিট ডায়াগ্রাম</button>
            </div>
            <div id="solutionBox" style="margin-top:18px; padding:14px; background:#F8FAFC; border-radius:8px; display:none;"></div>
        </div>
    </section>

    <!-- 📦 নতুন: স্টক ও পার্টস -->
    <section class="page" id="inventory">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
            <h2 class="page-title" style="border:none; margin:0;">স্টক ও পার্টস ব্যবস্থাপনা</h2>
            <button class="btn btn-primary" onclick="showPage('addStock')">➕ নতুন পার্টস যুক্ত</button>
        </div>
        <div class="filter-group">
            <button class="filter-btn active" onclick="renderStock('all')">সব পার্টস</button>
            <button class="filter-btn" onclick="renderStock('low')">⚠️ কম স্টক</button>
        </div>
        <div id="stockList"></div>
    </section>
    <section class="page" id="addStock">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
            <h2 class="page-title" style="border:none; margin:0;">নতুন পার্টস যুক্ত করুন</h2>
            <button class="btn btn-outline" onclick="showPage('inventory')">← ফিরে যান</button>
        </div>
        <form id="stockForm" class="card">
            <div class="form-group">
                <label>পার্টসের কোড/বারকোড</label>
                <div class="scan-field">
                    <input type="text" id="stockCode">
                    <button type="button" class="btn btn-success" onclick="openScanner()">📲 স্ক্যান</button>
                </div>
            </div>
            <div class="form-group"><label>পার্টসের নাম *</label><input type="text" id="stockName" required></div>
            <div class="form-row">
                <div class="form-group"><label>প্রারম্ভিক পরিমাণ *</label><input type="number" id="stockQty" min="1" required></div>
                <div class="form-group"><label>সতর্কতা সীমা</label><input type="number" id="stockAlert" min="1" value="5"></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>ক্রয় মূল্য (টাকা)</label><input type="number" id="buyPrice" min="0" value="0"></div>
                <div class="form-group"><label>বিক্রয়/ব্যবহার মূল্য (টাকা)</label><input type="number" id="sellPrice" min="0" value="0"></div>
            </div>
            <div style="margin-top:16px;">
                <button type="submit" class="btn btn-primary">সংরক্ষণ করুন</button>
                <button type="reset" class="btn btn-outline">রিসেট</button>
            </div>
        </form>
    </section>

    <!-- 👥 নতুন: গ্রাহক তালিকা -->
    <section class="page" id="customers">
        <h2 class="page-title">গ্রাহক তালিকা</h2>
        <div class="card">
            <input type="text" placeholder="নাম বা ফোন নম্বর দিয়ে খুঁজুন..." id="custSearch" style="width:100%; padding:10px; border:1px solid var(--border); border-radius:8px;">
        </div>
        <div id="custList"></div>
    </section>

    <!-- 💳 নতুন: হিসাব-নিকাশ -->
    <section class="page" id="accounts">
        <h2 class="page-title">হিসাব-নিকাশ ও বিলিং</h2>
        <div class="summary-box">
            <div class="card"><h3 style="color:var(--success)" id="accTotalAdvance">০</h3><p>মোট অগ্রিম</p></div>
            <div class="card"><h3 style="color:var(--warning)" id="accTotalDue">০</h3><p>মোট বাকি</p></div>
            <div class="card"><h3 style="color:var(--primary)" id="accTotalService">০</h3><p>সার্ভিস ফি</p></div>
            <div class="card"><h3 style="color:var(--info)" id="accTotalParts">০</h3><p>পার্টস বাবদ</p></div>
        </div>
        <div class="card">
            <h3 style="margin-bottom:12px;">লেনদেনের ধরন</h3>
            <div class="filter-group">
                <button class="filter-btn active" onclick="alert('সব লেনদেন দেখা যাচ্ছে')">সব</button>
                <button class="filter-btn" onclick="alert('আজকের হিসাব দেখা যাবে')">আজকের</button>
                <button class="filter-btn" onclick="alert('মাসের হিসাব দেখা যাবে')">এই মাসের</button>
            </div>
        </div>
        <div class="card" style="text-align:center; color:var(--gray);">
            📌 পেমেন্ট পদ্ধতি, বিল প্রিন্ট ও রিপোর্ট ফিচার শীঘ্রই আপডেট দেওয়া হবে। এখন পর্যন্ত টিকিট থেকে টাকার তথ্য সংরক্ষণ হচ্ছে।
        </div>
    </section>

    <!-- ⚙️ নতুন: সেটিংস ও ব্যাকআপ -->
    <section class="page" id="settings">
        <h2 class="page-title">সেটিংস ও ব্যাকআপ</h2>
        <div class="card">
            <h3 style="margin-bottom:12px;">ডেটা পরিচালনা</h3>
            <div style="display:flex; flex-direction:column; gap:10px;">
                <button class="btn btn-primary" onclick="exportData()">💾 সম্পূর্ণ ডেটা ব্যাকআপ ফাইল হিসেবে সংরক্ষণ</button>
                <button class="btn btn-outline" onclick="alert('আপডেট পাওয়া গেলে জানিয়ে দেব')">🔄 নতুন সংস্করণ চেক করুন</button>
                <button class="btn btn-outline" onclick="alert('ভাষা পরিবর্তন শীঘ্রই যুক্ত করা হবে')">🌐 ভাষা পরিবর্তন</button>
            </div>
        </div>
        <div class="card" style="color:var(--gray); font-size:13px;">
            <p>⚠️ সতর্কতা: আপনার সব ডেটা এই ব্রাউজারের স্থানীয় স্টোরেজে থাকে। ব্রাউজার বা ফোন পরিবর্তনের আগে ব্যাকআপ নিন।</p>
        </div>
    </section>
</main>

<!-- মোডাল -->
<div class="modal" id="scannerModal">
    <div class="modal-content">
        <button class="modal-close" onclick="closeScanner()">✕</button>
        <h3 style="margin-bottom:12px;">বারকোড / কিউআর কোড স্ক্যান</h3>
        <div id="reader"></div>
        <div id="scanRes" style="margin-top:12px; padding:10px; background:#F1F5F9; border-radius:6px; text-align:center;">স্ক্যান করার জন্য প্রস্তুত</div>
    </div>
</div>
<div class="modal" id="receiptModal">
    <div class="modal-content">
        <button class="modal-close" onclick="closeReceipt()">✕</button>
        <div class="receipt-preview" id="receiptBox"></div>
        <div style="text-align:center; margin-top:14px;">
            <button class="btn btn-primary" onclick="window.print()">🖨️ প্রিন্ট</button>
        </div>
    </div>
</div>

<script>
// ডেটা সংরক্ষণ
let tickets = JSON.parse(localStorage.getItem('repairTicketsV2') || localStorage.getItem('repairTickets') || '[]');
let ticketIdCounter = parseInt(localStorage.getItem('ticketCounterV2') || localStorage.getItem('ticketIdCounter') || '1003');
let stockItems = JSON.parse(localStorage.getItem('stockItems') || '[]');
let customers = JSON.parse(localStorage.getItem('customerList') || '[]');
let scanner = null;
let activeFilter = 'all';

// নেটওয়ার্ক স্ট্যাটাস
function updateNetStatus() {
    const isOnline = navigator.onLine;
    document.getElementById('netDot').className = 'status-dot ' + (isOnline ? '' : 'offline');
    document.getElementById('netText').textContent = isOnline ? 'অনলাইন' : 'অফলাইন';
}
window.addEventListener('online', updateNetStatus);
window.addEventListener('offline', updateNetStatus);
updateNetStatus();

// সাইডবার ও পেজ নিয়ন্ত্রণ
function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('show');
    document.getElementById('sidebarOverlay').classList.toggle('show');
}
function showPage(pageId) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById(pageId).classList.add('active');
    document.querySelectorAll('.sidebar-link').forEach(l => l.classList.remove('active'));
    document.querySelector(`.sidebar-link[data-page="${pageId}"]`)?.classList.add('active');
    toggleSidebar();
    updateDashboard();
    if(pageId === 'tickets') renderTickets();
    if(pageId === 'inventory') renderStock('all');
    if(pageId === 'customers') renderCustomers();
}

// সংরক্ষণ
function syncData() {
    localStorage.setItem('repairTicketsV2', JSON.stringify(tickets));
    localStorage.setItem('ticketCounterV2', ticketIdCounter);
    localStorage.setItem('stockItems', JSON.stringify(stockItems));
    localStorage.setItem('customerList', JSON.stringify(customers));
    alert('✅ সব ডেটা সফলভাবে সংরক্ষিত হয়েছে!');
}

// স্ক্যানার
function openScanner() {
    document.getElementById('scannerModal').classList.add('active');
    document.getElementById('scanRes').textContent = 'ক্যামেরা বা ছবি দিয়ে স্ক্যান করুন';
    if(!scanner) scanner = new Html5QrcodeScanner("reader", { fps:10, qrbox:{width:250, height:250} }, false);
    scanner.render(onScanOk, onScanErr);
}
function closeScanner() {
    document.getElementById('scannerModal').classList.remove('active');
    if(scanner) { scanner.clear().catch(()=>{}); scanner = null; }
}
function onScanOk(res) {
    document.getElementById('scanRes').textContent = '✅ পাওয়া গেছে: ' + res;
    if(document.getElementById('devCode')) document.getElementById('devCode').value = res;
    if(document.getElementById('diagCode')) document.getElementById('diagCode').value = res;
    if(document.getElementById('stockCode')) document.getElementById('stockCode').value = res;
    alert('কোড সফলভাবে পাওয়া গেছে: ' + res);
    closeScanner();
}
function onScanErr(e) { console.warn(e); }

// ড্যাশবোর্ড আপডেট
function updateDashboard() {
    document.getElementById('dTotal').textContent = tickets.length;
    document.getElementById('dRunning').textContent = tickets.filter(t => ['জমা নেওয়া হয়েছে','পরীক্ষা করা হচ্ছে','পার্টসের অপেক্ষায়','ডেলিভারির জন্য প্রস্তুত'].includes(t.status)).length;
    document.getElementById('dReady').textContent = tickets.filter(t => t.status === 'ডেলিভারির জন্য প্রস্তুত').length;
    document.getElementById('dDelivered').textContent = tickets.filter(t => t.status === 'ডেলিভারি দেওয়া হয়েছে').length;
    document.getElementById('dCust').textContent = customers.length;
    document.getElementById('dStock').textContent = stockItems.length;
    const totalAdv = tickets.reduce((s,t) => s + (Number(t.advPay) || 0), 0);
    const totalDue = tickets.reduce((s,t) => s + (Number(t.totalCost) || 0) - (Number(t.advPay) || 0), 0);
    document.getElementById('dIncome').textContent = totalAdv + ' টাকা';
    document.getElementById('dDue').textContent = totalDue + ' টাকা';
    document.getElementById('accTotalAdvance').textContent = totalAdv + ' টাকা';
    document.getElementById('accTotalDue').textContent = totalDue + ' টাকা';
}

// টিকিট ফাংশন
function filterTickets(f) { activeFilter = f; document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active')); event.target.classList.add('active'); renderTickets(); }
function renderTickets() {
    const list = activeFilter === 'all' ? tickets : tickets.filter(t => t.status === activeFilter);
    document.getElementById('ticketList').innerHTML = list.length ? list.map(t => `
        <div class="ticket-card">
            <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:6px;">
                <strong>${t.id} • ${t.date}</strong>
                <span class="filter-btn ${getStatusColor(t.status)}">${t.status}</span>
            </div>
            <div style="margin-top:8px; font-size:14px;">
                নাম: ${t.custName} • ফোন: ${t.custMobile}<br>
                ডিভাইস: ${t.devCat} ${t.devModel||''} • কোড: ${t.devCode||'নেই'}<br>
                সমস্যা: ${t.problem||'উল্লেখ নেই'} • অগ্রিম: ${t.advPay||0} টাকা • মোট: ${t.totalCost||0} টাকা
            </div>
            <div class="ticket-actions">
                <button class="btn btn-sm btn-outline" onclick="updStatus('${t.id}','জমা নেওয়া হয়েছে')">জমা</button>
                <button class="btn btn-sm btn-outline" onclick="updStatus('${t.id}','পরীক্ষা করা হচ্ছে')">পরীক্ষা</button>
                <button class="btn btn-sm btn-outline" onclick="updStatus('${t.id}','ডেলিভারির জন্য প্রস্তুত')">প্রস্তুত</button>
                <button class="btn btn-sm btn-success" onclick="updStatus('${t.id}','ডেলিভারি দেওয়া হয়েছে')">ডেলিভারি</button>
                <button class="btn btn-sm btn-warning" onclick="sendWA('${t.id}')">💬 হোয়াটসঅ্যাপ</button>
                <button class="btn btn-sm btn-primary" onclick="printRec('${t.id}')">🖨️ রশিদ</button>
                <button class="btn btn-sm btn-danger" onclick="delTkt('${t.id}')">🗑️ মুছুন</button>
            </div>
        </div>`).join('') : '<div class="card" style="text-align:center; color:var(--gray);">কোনো টিকিট পাওয়া যায়নি</div>';
}
function getStatusColor(s) {
    if(s.includes('জমা')) return 'status-received';
    if(s.includes('পরীক্ষা')) return 'status-diagnosing';
    if(s.includes('অপেক্ষা')) return 'status-waiting';
    if(s.includes('প্রস্তুত')) return 'status-ready';
    if(s.includes('ডেলিভারি')) return 'status-delivered';
    return 'status-cancel';
}
function updStatus(id,ns) { const t = tickets.find(x=>x.id===id); if(!t)return; t.status=ns; syncData(); renderTickets(); updateDashboard(); }
function delTkt(id) { if(!confirm('নিশ্চিত মুছবেন?'))return; tickets = tickets.filter(x=>x.id!==id); syncData(); renderTickets(); updateDashboard(); }
function sendWA(id) { const t = tickets.find(x=>x.id===id); if(!t)return; const msg = `আসসালামু আলাইকুম ${t.custName}।\nটিকিট: ${t.id}\nডিভাইস: ${t.devCat} ${t.devModel||''}\nঅবস্থা: ${t.status}\nযোগাযোগ করুন। ধন্যবাদ।`; window.open(`https://wa.me/88${t.custMobile.replace(/\D/g,'')}?text=${encodeURIComponent(msg)}`); }
function printRec(id) { const t = tickets.find(x=>x.id===id); if(!t)return; document.getElementById('receiptBox').innerHTML = `
    <h3>মেরামত রশিদ</h3><p>টিকিট: ${t.id}</p><p>তারিখ: ${t.date}</p><p>গ্রাহক: ${t.custName}</p><p>ফোন: ${t.custMobile}</p>
    <p>ডিভাইস: ${t.devCat} ${t.devModel||'—'}</p><p>সমস্যা: ${t.problem||'—'}</p><p>অগ্রিম: ${t.advPay||0} টাকা</p><p>মোট: ${t.totalCost||0} টাকা</p>
    <hr style="border-style:dashed; margin:10px 0;"><p style="font-size:11px;">ধন্যবাদ</p>`;
    document.getElementById('receiptModal').classList.add('active');
}
function closeReceipt() { document.getElementById('receiptModal').classList.remove('active'); }

// নতুন টিকিট জমা
document.getElementById('ticketFormMain').addEventListener('submit', e=>{
    e.preventDefault();
    const newId = `TKT-${++ticketIdCounter}`;
    const t = {
        id: newId, date: new Date().toLocaleString('bn-BD'), status: 'জমা নেওয়া হয়েছে',
        custName: document.getElementById('custName').value,
        custMobile: document.getElementById('custMobile').value,
        custAddr: document.getElementById('custAddr').value,
        devCode: document.getElementById('devCode').value,
        devCat: document.getElementById('devCat').value,
        devModel: document.getElementById('devModel').value,
        lockPattern: document.getElementById('lockPattern').value,
        accessories: { charger: document.getElementById('accCharger').checked, mem: document.getElementById('accMem').checked, sim: document.getElementById('accSim').checked, box: document.getElementById('accBox').checked },
        problem: document.getElementById('devProblem').value,
        advPay: document.getElementById('advPay').value,
        totalCost: document.getElementById('totalCost').value
    };
    tickets.unshift(t);
    // গ্রাহক তালিকায় যুক্ত
    const exists = customers.find(c => c.mobile === t.custMobile);
    if(!exists) customers.push({ name: t.custName, mobile: t.custMobile, addr: t.custAddr, firstDate: t.date, totalTickets:1 });
    else exists.totalTickets++;
    syncData();
    alert(`✅ নতুন টিকিট তৈরি: ${newId}`);
    e.target.reset();
    showPage('tickets');
});

// স্টক ফাংশন
document.getElementById('stockForm').addEventListener('submit', e=>{
    e.preventDefault();
    const item = {
        id: 'STK-'+Date.now(), code: document.getElementById('stockCode').value,
        name: document.getElementById('stockName').value, qty: Number(document.getElementById('stockQty').value),
        alert: Number(document.getElementById('stockAlert').value), buy: Number(document.getElementById('buyPrice').value), sell: Number(document.getElementById('sellPrice').value)
    };
    stockItems.push(item);
    syncData(); alert('✅ পার্টস যুক্ত হয়েছে'); e.target.reset(); showPage('inventory');
});
function renderStock(f) {
    const show = f === 'low' ? stockItems.filter(i => i.qty <= i.alert) : stockItems;
    document.getElementById('stockList').innerHTML = show.length ? show.map(i => `
        <div class="stock-card">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap;">
                <strong>${i.name}</strong>
                <span style="color:${i.qty<=i.alert?'var(--danger)':'var(--success)'}">পরিমাণ: ${i.qty} টি</span>
            </div>
            <div style="font-size:14px; margin-top:6px;">কোড: ${i.code||'নেই'} • ক্রয়: ${i.buy} • বিক্রয়: ${i.sell} • সতর্কতা: ${i.alert}</div>
            <div class="stock-actions">
                <button class="btn btn-sm btn-success" onclick="chgStock('${i.id}',1)">+১ যুক্ত</button>
                <button class="btn btn-sm btn-warning" onclick="chgStock('${i.id}',-1)">-১ বিয়োগ</button>
                <button class="btn btn-sm btn-danger" onclick="delStock('${i.id}')">🗑️ মুছুন</button>
            </div>
        </div>`).join('') : '<div class="card" style="text-align:center; color:var(--gray);">কোনো পার্টস পাওয়া যায়নি</div>';
    document.querySelector(`.filter-btn[onclick="renderStock('${f}')"]`)?.classList.add('active');
}
function chgStock(id,val) { const i = stockItems.find(x=>x.id===id); if(!i)return; if(i.qty+val<0)return alert('পরিমাণ শূন্যের নিচে যাবে না!'); i.qty+=val; syncData(); renderStock('all'); updateDashboard(); }
function delStock(id) { if(!confirm('মুছে ফেলবেন?'))return; stockItems = stockItems.filter(x=>x.id!==id); syncData(); renderStock('all'); updateDashboard(); }

// গ্রাহক তালিকা
function renderCustomers() {
    document.getElementById('custList').innerHTML = customers.length ? customers.map(c => `
        <div class="cust-card">
            <strong>${c.name}</strong><br>ফোন: ${c.mobile} • ঠিকানা: ${c.addr||'—'}<br>মোট টিকিট: ${c.totalTickets||0} টি • প্রথম যোগাযোগ: ${c.firstDate||'—'}
        </div>`).join('') : '<div class="card" style="text-align:center; color:var(--gray);">কোনো গ্রাহক নেই</div>';
}

// ডায়াগনস্টিক সমাধান
function showSolution() {
    const sym = Array.from(document.querySelectorAll('.symptom:checked')).map(c=>c.parentElement.textContent.trim());
    const box = document.getElementById('solutionBox');
    box.style.display = 'block';
    if(sym.length===0) { box.innerHTML = '⚠️ অনুগ্রহ করে অন্তত একটি সমস্যা বেছে নিন।'; return; }
    box.innerHTML = `<h4>💡 প্রাথমিক পরামর্শ:</h4><ul style="padding-left:20px; margin-top:8px;">` + sym.map(s => {
        if(s.includes('পাওয়ার নেই')) return `<li>চার্জার ও পোর্ট পরীক্ষা করুন, ব্যাটারি সংযোগ যাচাই করুন।</li>`;
        if(s.includes('চার্জ হচ্ছে')) return
